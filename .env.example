# Database Configuration
DB_TYPE=postgresql  # postgresql or mongodb

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_guidance

# MongoDB (alternative)
MONGO_USER=user
MONGO_PASSWORD=password
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=career_guidance

# Scraper Configuration
REMOTE_OK_API_KEY=optional_key
SELENIUM_HEADLESS=true
SCRAPER_DELAY=2  # seconds between requests

# Application
DEBUG=true
LOG_LEVEL=INFO
